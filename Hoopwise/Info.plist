<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Hoopwise</string>
	<key>NSCameraUsageDescription</key>
	<string>Hoopwise needs camera access to take profile photos of students.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Hoopwise needs photo library access to select profile photos for students.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Hoopwise needs permission to save photos to your library.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Hoopwise uses speech recognition to transcribe voice notes during sessions.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hoopwise needs microphone access for voice-to-text note taking during sessions.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Hoopwise Bundle</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.hoopwise.bundle</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.hoopwise.bundle</string>
			<key>UTTypeDescription</key>
			<string>Hoopwise Bundle</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>hoopwise</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-hoopwise-bundle</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
